# Copy to .env on the Raspberry Pi and fill in. NEVER commit .env.

# Telegram (from @BotFather and @userinfobot, see docs/02-iphone-setup.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# LLM provider for the agent (Hermes Agent / OpenClaw)
LLM_PROVIDER=
LLM_API_KEY=

# Glider link
GLIDER_SSID=Tuba-Glider
GLIDER_WIFI_PSK=
GLIDER_IFACE=wlan1
GLIDER_IP=192.168.4.1
GLIDER_TELNET_PORT=23
OTA_HTTP_PORT=8000

# MCUboot signing key (kept OUTSIDE the repo)
MCUBOOT_SIGNING_KEY=/home/pi/keys/tuba-ecdsa-p256.pem
